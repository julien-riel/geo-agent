# LLM provider: "ollama" (local) or "openrouter" (cloud)
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# OpenRouter (used when LLM_PROVIDER=openrouter)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-haiku-4-5
# Optional, sent as HTTP-Referer / X-Title for OpenRouter analytics
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=geo-agent

# WFS
WFS_BASE_URL=https://api.accept.montreal.ca/api/it-platforms/geomatic/wfs-maps/montreal/ows
WFS_HTTP_TIMEOUT_SECONDS=30

# Frontend basemap
NEXT_PUBLIC_BASEMAP_STYLE_URL=https://api.accept.montreal.ca/api/it-platforms/geomatic/map-assets/v1/styles/fond-de-carte

# Storage
DATA_DIR=./data

# Limits
MAX_FEATURES_PER_QUERY=5000
MAX_FILTER_GEOMETRY_VERTICES=1000

# Backend URL (used by frontend's CopilotKit adapter)
BACKEND_URL=http://localhost:8000
